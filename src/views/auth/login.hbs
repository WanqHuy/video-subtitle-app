<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card card-modern p-4 p-lg-5 shadow-sm">
        <div class="text-center mb-4">
          <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
          <h3 class="fw-bold mt-2">Đăng Nhập</h3>
          <p class="text-muted small">Truy cập để sử dụng toàn bộ tính năng của AI Subtitle</p>
        </div>

        {{#if infoMessage}}
          <div class="alert alert-warning border-0 rounded-3 small mb-3">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> {{infoMessage}}
          </div>
        {{/if}}

        {{#if error}}
          <div class="alert alert-danger border-0 rounded-3 small mb-3">
            <i class="bi bi-x-circle-fill me-1"></i> {{error}}
          </div>
        {{/if}}

        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold small">Địa chỉ Email:</label>
            <input type="email" name="email" class="form-control rounded-3 py-2" placeholder="name@example.com" required>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold small">Mật khẩu:</label>
            <input type="password" name="password" class="form-control rounded-3 py-2" placeholder="••••••••" required>
          </div>
          <button type="submit" class="btn btn-gradient w-100 py-2 rounded-pill fw-bold">
            Đăng Nhập Ngay
          </button>
        </form>

        <p class="text-center mt-4 text-muted small mb-0">
          Chưa có tài khoản? <a href="/register" class="text-primary fw-bold text-decoration-none">Đăng ký mới</a>
        </p>
      </div>
    </div>
  </div>
</div>
