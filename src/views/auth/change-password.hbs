<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card-modern p-4 p-lg-5">
        <div class="text-center mb-4">
          <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex p-3 mb-2">
            <i class="bi bi-shield-lock-fill fs-3"></i>
          </div>
          <h3 class="fw-extrabold text-dark tracking-tight">Đổi Mật Khẩu</h3>
          <p class="text-muted small">Cập nhật mật khẩu mới an toàn cho tài khoản</p>
        </div>

        {{#if error}}
          <div class="alert alert-danger rounded-3 py-2 small mb-3 border-0 text-center">
            <i class="bi bi-exclamation-circle me-1"></i> {{error}}
          </div>
        {{/if}}

        {{#if success}}
          <div class="alert alert-success rounded-3 py-2 small mb-3 border-0 text-center">
            <i class="bi bi-check-circle me-1"></i> {{success}}
          </div>
        {{/if}}

        <form action="/change-password" method="POST" id="changePasswordForm">
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Mật khẩu hiện tại:</label>
            <input type="password" name="currentPassword" class="form-control form-control-lg rounded-pill fs-6" placeholder="••••••••" required>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-bold text-muted">Mật khẩu mới:</label>
            <input type="password" name="newPassword" id="newPassword" class="form-control form-control-lg rounded-pill fs-6" placeholder="Tối thiểu 8 ký tự (chữ + số)" required minlength="8">
          </div>
          <div class="form-text small text-muted mb-3 px-2">
            <i class="bi bi-info-circle text-primary"></i> Tối thiểu 8 ký tự, phải gồm cả chữ và số.
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-muted">Xác nhận mật khẩu mới:</label>
            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control form-control-lg rounded-pill fs-6" placeholder="Nhập lại mật khẩu mới" required minlength="8">
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow">
            Cập Nhật Mật Khẩu
          </button>
        </form>

        <div class="text-center mt-4 pt-2 border-top">
          <a href="/workspace" class="small fw-semibold text-secondary text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Quay lại Studio
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('changePasswordForm');
  const newPass = document.getElementById('newPassword');
  const confirmPass = document.getElementById('confirmPassword');

  form.addEventListener('submit', (e) => {
    const val = newPass.value;
    const hasLetter = /[a-zA-Z]/.test(val);
    const hasNumber = /[0-9]/.test(val);

    if (val.length < 8 || !hasLetter || !hasNumber) {
      e.preventDefault();
      alert('Mật khẩu mới phải có tối thiểu 8 ký tự và gồm cả chữ lẫn số!');
      newPass.focus();
      return;
    }

    if (val !== confirmPass.value) {
      e.preventDefault();
      alert('Mật khẩu xác nhận không trùng khớp với mật khẩu mới!');
      confirmPass.focus();
    }
  });
</script>