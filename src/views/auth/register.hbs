<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card-modern p-4 p-lg-5">
        <div class="text-center mb-4">
          <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex p-3 mb-2">
            <i class="bi bi-person-plus-fill fs-3"></i>
          </div>
          <h3 class="fw-extrabold text-dark tracking-tight">Tạo Tài Khoản Mới</h3>
          <p class="text-muted small">Đăng ký nhận ngay <strong>30 phút</strong> phụ đề AI miễn phí</p>
        </div>

        {{#if error}}
          <div class="alert alert-danger rounded-3 py-2 small mb-3 border-0 text-center">
            <i class="bi bi-exclamation-circle me-1"></i> {{error}}
          </div>
        {{/if}}

        <form action="/register" method="POST" id="registerForm">
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Họ và tên:</label>
            <input type="text" name="name" class="form-control form-control-lg rounded-pill fs-6" placeholder="Nguyễn Văn A" value="{{name}}" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Email:</label>
            <input type="email" name="email" class="form-control form-control-lg rounded-pill fs-6" placeholder="tenban@gmail.com" value="{{email}}" required>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-bold text-muted">Mật khẩu:</label>
            <input type="password" name="password" id="regPassword" class="form-control form-control-lg rounded-pill fs-6" placeholder="Tối thiểu 8 ký tự (gồm chữ và số)" required minlength="8">
          </div>
          <div class="form-text small text-muted mb-3 px-2">
            <i class="bi bi-shield-check text-primary"></i> Yêu cầu tối thiểu 8 ký tự, gồm cả chữ cái và số.
          </div>

          <!-- Đồng ý điều khoản sử dụng -->
          <div class="form-check mb-4 px-4 text-start">
            <input class="form-check-input" type="checkbox" name="agreeTerms" id="agreeTerms" required>
            <label class="form-check-label small text-muted user-select-none" for="agreeTerms">
              Tôi đồng ý với <a href="#" class="text-primary fw-semibold text-decoration-none" onclick="alert('Điều khoản dịch vụ: Hệ thống cung cấp dịch vụ phụ đề video tự động. Vui lòng không upload video vi phạm pháp luật.'); return false;">Điều khoản sử dụng</a> và <a href="#" class="text-primary fw-semibold text-decoration-none" onclick="alert('Chính sách bảo mật: Toàn bộ video và dữ liệu của bạn được bảo mật tuyệt đối.'); return false;">Chính sách bảo mật</a>
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow">
            Đăng Ký & Nhận 30 Phút
          </button>
        </form>

        <div class="text-center mt-4 pt-2 border-top">
          <span class="small text-muted">Đã có tài khoản? </span>
          <a href="/login" class="small fw-bold text-primary text-decoration-none">Đăng nhập ngay</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Validate trực tiếp phía trình duyệt trước khi gửi form
  const registerForm = document.getElementById('registerForm');
  const regPassword = document.getElementById('regPassword');

  registerForm.addEventListener('submit', (e) => {
    const val = regPassword.value;
    const hasLetter = /[a-zA-Z]/.test(val);
    const hasNumber = /[0-9]/.test(val);

    if (val.length < 8 || !hasLetter || !hasNumber) {
      e.preventDefault();
      alert('Mật khẩu chưa đạt chuẩn! Vui lòng nhập tối thiểu 8 ký tự gồm cả chữ và số.');
      regPassword.focus();
    }
  });
</script>