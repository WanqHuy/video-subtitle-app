<div class="container py-5">
  <div class="text-center mb-5">
    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Bảng Giá Nâng Cấp</span>
    <h2 class="display-6 fw-extrabold text-dark tracking-tight">Lựa Chọn Gói Phù Hợp Nhu Cầu</h2>
    <p class="text-muted mx-auto" style="max-width: 550px;">
      Mở khóa không giới hạn độ dài video, loại bỏ Watermark bản quyền và nâng cấp tốc độ nhận diện âm thanh.
    </p>
  </div>

  <div class="row g-4 justify-content-center align-items-stretch">
    {{#if packages.length}}
      {{#each packages}}
        <div class="col-lg-4 col-md-6">
          <div class="card-modern h-100 p-4 p-xl-5 d-flex flex-column justify-content-between position-relative">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-3 py-2 rounded-pill fw-bold small">
                  <i class="bi bi-clock-history me-1"></i> +{{this.durationMinutes}} Phút
                </span>
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small fw-semibold">
                  Chuẩn {{this.accuracy}}
                </span>
              </div>

              <h4 class="fw-extrabold text-dark mb-2">{{this.name}}</h4>
              <p class="text-muted small mb-4" style="min-height: 48px;">{{this.description}}</p>

              <div class="py-3 my-2 border-top border-bottom d-flex align-items-baseline gap-2">
                <span class="display-6 fw-extrabold text-dark">{{formatCurrency this.price}}</span>
                <span class="text-muted small">/ trọn gói</span>
              </div>

              <ul class="list-unstyled d-flex flex-column gap-3 small text-secondary my-4">
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i> Nhận diện tự động bằng Whisper Large v3
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i> Dịch tự động tiếng Việt đúng ngữ cảnh
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i> Tải file rời <code>.SRT</code> & render video Hardsub
                </li>
              </ul>
            </div>

            <div class="d-flex flex-column gap-2 mt-4 pt-2">
              <form action="/cart/add" method="POST">
                <input type="hidden" name="packageId" value="{{this._id}}">
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm">
                  <i class="bi bi-cart-plus me-1"></i> Mua Gói Này
                </button>
              </form>
              <a href="/packages/{{this._id}}" class="btn btn-light border w-100 rounded-pill py-2 small fw-semibold text-secondary">
                Xem chi tiết quyền lợi
              </a>
            </div>
          </div>
        </div>
      {{/each}}
    {{else}}
      <div class="col-12 text-center py-5">
        <i class="bi bi-box2 display-3 text-muted"></i>
        <p class="text-muted mt-3">Chưa có gói cước nào được tạo.</p>
      </div>
    {{/if}}
  </div>
</div>