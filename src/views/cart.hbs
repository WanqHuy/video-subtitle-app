<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h3 class="fw-extrabold text-dark tracking-tight mb-1">Giỏ Hàng Dịch Vụ</h3>
          <small class="text-muted">Kiểm tra các gói phút đã chọn trước khi tiến hành thanh toán VietQR</small>
        </div>
        <a href="/packages" class="btn btn-light border btn-sm rounded-pill px-3 fw-semibold text-secondary">
          <i class="bi bi-arrow-left me-1"></i> Xem thêm gói khác
        </a>
      </div>

      {{#if cart.length}}
        <div class="row g-4">
          <div class="col-lg-8">
            <div class="card-modern p-4">
              <div class="table-responsive">
                <table class="table align-middle mb-0">
                  <thead class="table-light text-muted small">
                    <tr>
                      <th class="py-3 border-0">GÓI CƯỚC</th>
                      <th class="py-3 border-0">THỜI LƯỢNG</th>
                      <th class="py-3 border-0">ĐƠN GIÁ</th>
                      <th class="py-3 border-0 text-center">SỐ LƯỢNG</th>
                      <th class="py-3 border-0 text-end">XÓA</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each cart}}
                      <tr>
                        <td class="fw-bold text-dark">{{this.name}}</td>
                        <td>
                          <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 rounded-pill">
                            +{{this.durationMinutes}} phút
                          </span>
                        </td>
                        <td class="fw-semibold">{{formatCurrency this.price}}</td>
                        <td class="text-center fw-bold">{{this.quantity}}</td>
                        <td class="text-end">
                          <a href="/cart/remove/{{this.id}}" class="btn btn-outline-danger btn-sm rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-trash3"></i>
                          </a>
                        </td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="card-modern p-4 sticky-top" style="top: 100px;">
              <h5 class="fw-bold text-dark mb-3">Tóm Tắt Thanh Toán</h5>
              <div class="d-flex justify-content-between mb-2 small text-muted">
                <span>Tạm tính:</span>
                <span class="fw-semibold text-dark">{{formatCurrency total}}</span>
              </div>
              <div class="d-flex justify-content-between mb-3 small text-muted">
                <span>Phương thức:</span>
                <span class="text-success fw-semibold">Quét mã VietQR</span>
              </div>

              <hr>

              <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="fw-bold text-dark">Tổng tiền:</span>
                <span class="fs-4 fw-extrabold text-danger">{{formatCurrency total}}</span>
              </div>

              <form action="/checkout" method="POST">
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow">
                  <i class="bi bi-qr-code me-1"></i> Quét Mã Thanh Toán
                </button>
              </form>
            </div>
          </div>
        </div>
      {{else}}
        <div class="card-modern p-5 text-center">
          <div class="rounded-circle bg-light d-inline-flex p-4 text-muted mb-3">
            <i class="bi bi-cart-x display-4"></i>
          </div>
          <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h4>
          <p class="text-muted small mb-4">Bạn chưa thêm gói cước nào vào giỏ hàng.</p>
          <a href="/packages" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
            Xem Bảng Giá Gói Dịch Vụ
          </a>
        </div>
      {{/if}}
    </div>
  </div>
</div>