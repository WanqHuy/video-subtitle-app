<div class="container py-5">
  <h2 class="fw-bold mb-4 d-flex align-items-center gap-2">
    <i class="bi bi-cart3 text-primary"></i> Giỏ Hàng Của Bạn
  </h2>

  {{#if cart.length}}
    <div class="card card-modern p-4 shadow-sm">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="py-3">Gói Dịch Vụ</th>
              <th class="py-3">Đơn Giá</th>
              <th class="py-3">Số Lượng</th>
              <th class="py-3">Thành Tiền</th>
              <th class="py-3 text-end">Hành Động</th>
            </tr>
          </thead>
          <tbody>
            {{#each cart}}
              <tr>
                <td class="py-3 fw-bold">{{this.name}}</td>
                <td class="py-3">{{formatCurrency this.price}}</td>
                <td class="py-3"><span class="badge bg-secondary px-3 py-2 rounded-pill">{{this.quantity}}</span></td>
                <td class="py-3 fw-bold text-primary">{{formatCurrency this.price}}</td>
                <td class="py-3 text-end">
                  <a href="/cart/remove/{{this.id}}" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    <i class="bi bi-trash"></i> Xoá
                  </a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <hr class="my-4 opacity-25">

      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted">Tổng cộng thanh toán:</span>
          <h3 class="fw-bold text-danger mb-0">{{formatCurrency total}}</h3>
        </div>
        <form action="/cart/checkout" method="POST">
          <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm">
            <i class="bi bi-credit-card me-2"></i> Xác Nhận Mua Hàng
          </button>
        </form>
      </div>
    </div>
  {{else}}
    <div class="card card-modern p-5 text-center shadow-sm">
      <i class="bi bi-cart-x text-muted fs-1 mb-3"></i>
      <h5 class="fw-bold">Giỏ hàng đang trống</h5>
      <p class="text-muted">Bạn chưa chọn gói phụ đề nào vào giỏ.</p>
      <div>
        <a href="/packages" class="btn btn-gradient rounded-pill px-4 py-2">Khám Phá Các Gói Dịch Vụ</a>
      </div>
    </div>
  {{/if}}
</div>