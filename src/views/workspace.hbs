<div class="container py-5">
  <div class="text-center mb-4">
    <div class="d-inline-flex align-items-center gap-2 bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small fw-semibold mb-2">
      <i class="bi bi-stars"></i> AI Speech Studio v2.0
    </div>
    <h2 class="display-6 fw-extrabold text-dark tracking-tight">Studio Tạo & Biên Tập Phụ Đề AI</h2>
    <p class="text-muted mx-auto" style="max-width: 600px;">
      Tải video lên để bóc tách âm thanh tự động, hiệu chỉnh thời gian và xuất video Hardsub sắc nét.
    </p>
  </div>

  <!-- BẢNG ĐẶC QUYỀN GÓI HIỆN TẠI -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <div class="card-modern p-4 bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 border-bottom mb-3 gap-2">
          <div>
            <span class="text-muted small">Cấp bậc tài khoản của bạn:</span>
            <span class="fs-5 fw-extrabold text-uppercase ms-2 
              {{#if (eq tier 'enterprise')}}text-warning{{else if (eq tier 'pro')}}text-info{{else if (eq tier 'basic')}}text-success{{else}}text-secondary{{/if}}">
              <i class="bi bi-shield-fill-check me-1"></i> {{#if tier}}{{tier}}{{else}}FREE{{/if}}
            </span>
          </div>
          {{#if (eq tier 'free')}}
            <a href="/packages" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
              <i class="bi bi-arrow-up-circle me-1"></i> Nâng cấp để bỏ Watermark & mở video dài
            </a>
          {{/if}}
        </div>

        <div class="row g-3 text-center text-md-start">
          <div class="col-6 col-md-3">
            <div class="small text-muted mb-1"><i class="bi bi-camera-video me-1"></i> Video tối đa/lần:</div>
            <div class="fw-bold fs-6">
              {{#if (eq tier 'enterprise')}}Không giới hạn
              {{else if (eq tier 'pro')}}Tối đa 60 phút
              {{else if (eq tier 'basic')}}Tối đa 15 phút
              {{else}}Tối đa 3 phút{{/if}}
            </div>
          </div>

          <div class="col-6 col-md-3">
            <div class="small text-muted mb-1"><i class="bi bi-badge-ad me-1"></i> Đóng dấu Watermark:</div>
            <div class="fw-bold fs-6">
              {{#if (eq tier 'enterprise')}}<span class="text-success"><i class="bi bi-check2"></i> Không (Sạch 100%)</span>
              {{else if (eq tier 'pro')}}<span class="text-success"><i class="bi bi-check2"></i> Không (Sạch 100%)</span>
              {{else if (eq tier 'basic')}}<span class="text-warning"><i class="bi bi-exclamation-circle"></i> Watermark nhỏ</span>
              {{else}}<span class="text-danger"><i class="bi bi-x-circle"></i> Có Watermark Free</span>{{/if}}
            </div>
          </div>

          <div class="col-6 col-md-3">
            <div class="small text-muted mb-1"><i class="bi bi-cpu me-1"></i> Bộ lọc mô hình:</div>
            <div class="fw-bold fs-6 text-dark">
              {{#if (eq tier 'free')}}Whisper v3 Cơ Bản{{else}}Whisper v3 Cao Cấp{{/if}}
            </div>
          </div>

          <div class="col-6 col-md-3">
            <div class="small text-muted mb-1"><i class="bi bi-palette me-1"></i> Kiểu chữ & Màu:</div>
            <div class="fw-bold fs-6">
              {{#if (eq tier 'free')}}<span class="text-muted">Chỉ Arial Trắng</span>
              {{else if (eq tier 'basic')}}<span class="text-dark">Trắng & Vàng</span>
              {{else}}<span class="text-success">Mở Toàn Bộ Màu</span>{{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CÁC BƯỚC THỰC HIỆN -->
  <div class="d-flex justify-content-center mb-5">
    <div class="d-flex align-items-center gap-3">
      <div class="text-center">
        <div class="rounded-circle {{#if step2}}bg-success text-white{{else if finalSuccess}}bg-success text-white{{else}}bg-primary text-white shadow{{/if}} d-flex align-items-center justify-content-center mx-auto fw-bold" style="width: 38px; height: 38px;">1</div>
        <div class="small fw-semibold mt-1">Tải Video</div>
      </div>
      <div class="border-top" style="width: 60px; height: 2px;"></div>
      <div class="text-center">
        <div class="rounded-circle {{#if step2}}bg-primary text-white shadow{{else if finalSuccess}}bg-success text-white{{else}}bg-light text-muted border{{/if}} d-flex align-items-center justify-content-center mx-auto fw-bold" style="width: 38px; height: 38px;">2</div>
        <div class="small fw-semibold mt-1">Biên Tập Sub</div>
      </div>
      <div class="border-top" style="width: 60px; height: 2px;"></div>
      <div class="text-center">
        <div class="rounded-circle {{#if finalSuccess}}bg-primary text-white shadow{{else}}bg-light text-muted border{{/if}} d-flex align-items-center justify-content-center mx-auto fw-bold" style="width: 38px; height: 38px;">3</div>
        <div class="small fw-semibold mt-1">Xuất Video</div>
      </div>
    </div>
  </div>

  {{#if error}}
    <div class="alert alert-danger rounded-4 p-3 mb-4 shadow-sm text-center border-0">
      <i class="bi bi-exclamation-triangle-fill me-2"></i> {{error}}
    </div>
  {{/if}}

  <!-- BƯỚC 1: UPLOAD VÀ HIỆN PREVIEW / THUMBNAIL -->
  {{#unless step2}}
    {{#unless finalSuccess}}
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card-modern p-4 p-md-5 text-center">
            <form action="/workspace/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
              <!-- Vùng kéo thả file -->
              <div class="upload-zone p-4 p-md-5 mb-4 position-relative" id="dropZone">
                <input class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" type="file" name="videoFile" accept="video/*" required id="videoInput">
                
                <!-- Giao diện lúc chưa chọn file -->
                <div id="emptyUploadPrompt">
                  <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex p-4 mb-3">
                    <i class="bi bi-cloud-arrow-up-fill display-5"></i>
                  </div>
                  <h4 class="fw-bold text-dark mb-1">Kéo thả tệp video vào đây</h4>
                  <p class="text-muted small mb-3">Hỗ trợ video MP4, MKV, WebM dung lượng tối đa 100MB</p>
                  <span class="btn btn-outline-primary rounded-pill btn-sm px-4 fw-semibold">
                    <i class="bi bi-folder2-open me-1"></i> Chọn file từ máy tính
                  </span>
                </div>

                <!-- Giao diện xem trước khi ĐÃ chọn file -->
                <div id="filePreviewArea" class="d-none">
                  <div class="position-relative mx-auto rounded-3 overflow-hidden shadow-sm bg-black mb-3" style="max-width: 480px; max-height: 280px;">
                    <video id="previewVideoTag" class="w-100 h-100" style="max-height: 280px; object-fit: contain;" controls></video>
                  </div>
                  <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                    <span class="badge bg-dark px-3 py-2 rounded-pill font-monospace" id="previewFileName">video.mp4</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill" id="previewFileSize">0 MB</span>
                    <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none fw-semibold" id="btnRemoveFile">
                      <i class="bi bi-x-circle me-1"></i> Đổi video khác
                    </button>
                  </div>
                </div>
              </div>

              <!-- Nút bấm submit kèm loading spinner -->
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow" id="submitBtn">
                <span id="btnText"><i class="bi bi-magic me-2"></i> Trích Xuất Phụ Đề Bằng AI</span>
                <span id="btnLoading" class="d-none">
                  <span class="spinner-border spinner-border-sm me-2"></span> Đang bóc tách âm thanh & nhận diện AI...
                </span>
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Script xử lý kéo thả & tạo thumbnail xem trước ngay lập tức -->
      <script>
        const videoInput = document.getElementById('videoInput');
        const emptyPrompt = document.getElementById('emptyUploadPrompt');
        const previewArea = document.getElementById('filePreviewArea');
        const previewVideoTag = document.getElementById('previewVideoTag');
        const previewFileName = document.getElementById('previewFileName');
        const previewFileSize = document.getElementById('previewFileSize');
        const btnRemove = document.getElementById('btnRemoveFile');
        const dropZone = document.getElementById('dropZone');
        const uploadForm = document.getElementById('uploadForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnLoading = document.getElementById('btnLoading');

        function handleFile(file) {
          if (!file) return;
          if (!file.type.startsWith('video/')) {
            alert('Vui lòng chọn một tệp video hợp lệ!');
            return;
          }

          previewFileName.textContent = file.name;
          previewFileSize.textContent = (file.size / (1024 * 1024)).toFixed(1) + ' MB';

          // Tạo URL xem trước video
          const videoUrl = URL.createObjectURL(file);
          previewVideoTag.src = videoUrl;

          emptyPrompt.classList.add('d-none');
          previewArea.classList.remove('d-none');
        }

        videoInput.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) {
            handleFile(e.target.files[0]);
          }
        });

        // Hiệu ứng kéo thả viền
        dropZone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropZone.style.borderColor = '#4f46e5';
          dropZone.style.background = '#f5f3ff';
        });

        dropZone.addEventListener('dragleave', (e) => {
          e.preventDefault();
          dropZone.style.borderColor = '#cbd5e1';
          dropZone.style.background = '#ffffff';
        });

        dropZone.addEventListener('drop', (e) => {
          dropZone.style.borderColor = '#cbd5e1';
          dropZone.style.background = '#ffffff';
        });

        btnRemove.addEventListener('click', (e) => {
          e.preventDefault();
          videoInput.value = '';
          previewVideoTag.src = '';
          previewArea.classList.add('d-none');
          emptyPrompt.classList.remove('d-none');
        });

        uploadForm.addEventListener('submit', () => {
          submitBtn.disabled = true;
          btnText.classList.add('d-none');
          btnLoading.classList.remove('d-none');
        });
      </script>
    {{/unless}}
  {{/unless}}

  <!-- BƯỚC 2: PREVIEW VÀ HIỆU CHỈNH PHỤ ĐỀ -->
  {{#if step2}}
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card-modern p-4 h-100">
          <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-play-circle text-primary"></i> Trình Xem Video
          </h5>
          <video class="w-100 rounded-3 shadow-sm mb-3 bg-black" controls src="{{videoUrl}}"></video>
          <div class="small text-muted d-flex justify-content-between">
            <span>Tệp: <strong>{{originalName}}</strong></span>
            <span>Độ dài: <strong>~{{videoDuration}} phút</strong></span>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card-modern p-4 h-100">
          <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-sliders text-primary"></i> Tùy Chỉnh Phụ Đề
          </h5>

          <form action="/workspace/render" method="POST">
            <input type="hidden" name="videoFilename" value="{{videoFilename}}">

            <div class="mb-3">
              <label class="form-label small fw-bold text-muted">Nội dung phụ đề (.SRT):</label>
              <textarea class="form-control rounded-3 font-monospace small bg-light" name="srtContent" rows="9" required>{{#each subtitleList}}{{this.index}}
{{this.startTime}} --> {{this.endTime}}
{{this.text}}

{{/each}}</textarea>
            </div>

            <div class="row g-2 mb-4">
              <div class="col-6">
                <label class="form-label small fw-bold text-muted">Cỡ chữ:</label>
                <select name="fontSize" class="form-select rounded-pill">
                  <option value="20">Nhỏ (20px)</option>
                  <option value="24" selected>Vừa (24px)</option>
                  <option value="28">Lớn (28px)</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small fw-bold text-muted">Màu sắc phụ đề:</label>
                <select name="fontColor" class="form-select rounded-pill">
                  <option value="white" selected>Màu Trắng</option>
                  {{#if (eq tier 'free')}}
                    <option value="yellow" disabled>Màu Vàng (Khóa - Gói Basic+)</option>
                    <option value="cyan" disabled>Màu Xanh Cyan (Khóa - Pro+)</option>
                    <option value="green" disabled>Màu Xanh Lá (Khóa - Pro+)</option>
                  {{else if (eq tier 'basic')}}
                    <option value="yellow">Màu Vàng</option>
                    <option value="cyan" disabled>Màu Xanh Cyan (Khóa - Pro+)</option>
                    <option value="green" disabled>Màu Xanh Lá (Khóa - Pro+)</option>
                  {{else}}
                    <option value="yellow">Màu Vàng</option>
                    <option value="cyan">Màu Xanh Cyan</option>
                    <option value="green">Màu Xanh Lá</option>
                  {{/if}}
                </select>
              </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm">
              <i class="bi bi-film me-1"></i> Tiến Hành Gắn Sub (Hardsub)
            </button>
          </form>
        </div>
      </div>
    </div>
  {{/if}}

  <!-- BƯỚC 3: TẢI VIDEO ĐÃ RENDER -->
  {{#if finalSuccess}}
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card-modern p-5 text-center">
          <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex p-4 mb-3">
            <i class="bi bi-check-circle-fill display-4"></i>
          </div>
          <h3 class="fw-extrabold text-dark mb-2">Gắn Phụ Đề Hoàn Tất!</h3>
          <p class="text-muted small mb-4">Video đã được gắn cứng phụ đề hoàn hảo và sẵn sàng tải về máy.</p>

          <video class="w-100 rounded-4 shadow mb-4 bg-black" controls src="{{outputVideoUrl}}"></video>

          <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a href="{{outputVideoUrl}}" download class="btn btn-primary btn-lg rounded-pill px-4 py-3 fw-bold shadow">
              <i class="bi bi-download me-2"></i> Tải Video MP4 Về Máy
            </a>
            <a href="/workspace" class="btn btn-light border btn-lg rounded-pill px-4 py-3 fw-semibold text-secondary">
              Tạo Video Mới
            </a>
          </div>
        </div>
      </div>
    </div>
  {{/if}}
</div>